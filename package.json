{
  "name": "matpool-cli",
  "version": "0.1.0",
  "description": "Command line tool for matpool.com (MatPool GPU cloud): login, browse the GPU market, rent and manage instances",
  "type": "module",
  "bin": {
    "matpool": "bin/matpool.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "scripts": {
    "check": "eslint .",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "prepack": "npm run check && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aoblex/matpool-cli.git"
  },
  "keywords": [
    "matpool",
    "gpu",
    "cli"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
